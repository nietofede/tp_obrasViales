# Valores de DEMO para desarrollo local. Copiar este archivo a .env.
# Para produccion, cambiar valores de las contraseñas.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_DB_USER=keycloak_user
KEYCLOAK_DB_PASSWORD=keycloak_pass

# Contraseñas de los usuarios de base de datos de cada microservicio (Para produccion se cambian!)
OBRAS_DB_PASSWORD=obras_pass
RECURSOS_DB_PASSWORD=recursos_pass
OPERACIONES_DB_PASSWORD=operaciones_pass

# Secreto del cliente "servicio-sistema" en Keycloak (cuenta de servicio SISTEMA).
# Lo usan el job diario y las llamadas entre servicios. Para produccion se cambia!
SERVICIO_SISTEMA_SECRET=sistema_secret_demo